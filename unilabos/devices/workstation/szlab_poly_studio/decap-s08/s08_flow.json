{
  "name": "szlab_s08_cap_station",
  "rules": [
    {
      "name": "complete S08 cap process after params are written",
      "trigger": {
        "node": "S08参数写入完成",
        "value": true,
        "edge": "rising"
      },
      "log_nodes": [
        "S08工艺选择",
        "S082瓶盖暂存位"
      ],
      "actions": [
        {"sleep": 0.05},
        {"write": {"node": "S08工艺完成", "value": 1}, "when": {"node": "S08工艺选择", "value": 1}},
        {"write": {"node": "S08工艺完成", "value": 2}, "when": {"node": "S08工艺选择", "value": 2}},
        {"write": {"node": "S08工艺完成", "value": 3}, "when": {"node": "S08工艺选择", "value": 3}},
        {"write": {"node": "S08工艺完成", "value": 4}, "when": {"node": "S08工艺选择", "value": 4}},
        {"write": {"node": "S08工艺完成", "value": 5}, "when": {"node": "S08工艺选择", "value": 5}},
        {"write": {"node": "S08工艺完成", "value": 6}, "when": {"node": "S08工艺选择", "value": 6}}
      ]
    },
    {
      "name": "clear S08 process complete after UniLab resets params_written",
      "trigger": {
        "node": "S08参数写入完成",
        "value": true,
        "edge": "falling"
      },
      "actions": [
        {"write": {"node": "S08工艺完成", "value": 0}}
      ]
    }
  ]
}
